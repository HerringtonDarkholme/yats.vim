Given typescript (switch statement):
  switch(e.key) {
  	case "Enter":
  		doEnter();
  		e.preventDefault();
  	case "Tab":
  		doTab();
  		e.preventDefault();
  		break;
  	case "Shift+Tab":
  		doShiftTab();
  	default:
  		doNothing();
  }
Do:
  ggVG=

Expect typescript (correct indentation):
  switch(e.key) {
  	case "Enter":
  		doEnter();
  		e.preventDefault();
  	case "Tab":
  		doTab();
  		e.preventDefault();
  		break;
  	case "Shift+Tab":
  		doShiftTab();
  	default:
  		doNothing();
  }

