Given typescript (Correct indentation after equals):
  function foo(
    bar = 1,
  ): number {
    return bar
  }
  const d = {
    foo: `another=word`,
    bar: true
  };
Do:
  ggVG=
Execute:
  AssertEqual 'typescriptStatementKeyword', SyntaxAt(4, 3)
  AssertEqual 'typescriptObjectLabel', SyntaxAt(8, 3)

